[Unit]
Description=SensorLeaf read-only sensor helper (RAPL, energy MSRs, APERF/MPERF)
Requires=sensorleaf-helper.socket

[Service]
Type=simple
ExecStartPre=-/usr/bin/modprobe -q msr
ExecStartPre=-/usr/bin/modprobe -q ryzen_smu
ExecStart=/usr/lib/sensorleaf/sensorleaf-helper
# Reading /dev/cpu/*/msr needs CAP_SYS_RAWIO; everything else is root-owned files.
CapabilityBoundingSet=CAP_SYS_RAWIO CAP_SYS_MODULE
AmbientCapabilities=
NoNewPrivileges=yes
DevicePolicy=closed
DeviceAllow=char-cpu/msr r
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service @module
